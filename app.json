{
  "expo": {
    "name": "NutriEdu",
    "slug": "nutriedu-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nutriedu",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.xrhon0s.nutriedu",
      "buildNumber": "1",
      "supportsTablet": false
    },
    "android": {
      "package": "com.xrhon0s.nutriedu",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#EAF7EF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3FAF6",
          "image": "./assets/images/nutriedu-logo.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#00A651",
          "defaultChannel": "nutriedu-reminders"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "NutriEdu necesita acceso a tus fotos para seleccionar una imagen de comida.",
          "cameraPermission": "NutriEdu necesita acceso a la camara para fotografiar una comida.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
